module

public meta import LeanScript.ToTerm.Ctx
public meta import LeanScript.CtorFn.Emit

@[expose] public section

meta section

/-!
# Datatypes with existentials, through the constructor functions

A value of a datatype with existentials (`Process`: a constructor hides the type of its
state) has no one tree of the language: its type depends on the value — on the hidden types
each constructor application chooses.  `#leanscript_to_term` translates such a value
constructor for constructor, with the **constructor functions of `#leanscript_ctor`**
(`LeanScript.CtorFn`), generated once and cached there:

* the type arguments of the constructor function are the trees of the Lean type arguments
  of the application — the parameters, the type indices, the hidden types;
* the tree of a field the constructor function leaves open (`procTy`, `transTy`: an
  occurrence of the datatype itself) is read off the translation of that field, or off the
  type the value is checked against;
* a hidden type that is an erased type (`Unit`) is not an argument: the constructor function
  generated for that use takes `Unit` in its field types, so a `Unit` field and a `Unit`
  binder are dropped, as everywhere in the language.

So the translation of such a value is **inferred bottom-up** — its type is the type of the
term that is built.  Where values of different types meet (the branches of an `if`), their
types are joined (`joinTy`) and the branches are translated again **against** the join
(`LeanScript.ToTerm.transCheck`): a hole of a layout is joined hole by hole, and two
different layouts become `TyWf.oneOf`, into which each value is injected.
-/

open Lean Meta Elab Term

namespace LeanScript.ToTerm

/-- `LeanScript.TyWf`, as an expression. -/
def tyWfTyE : Expr := mkConst ``LeanScript.TyWf

/-- `TyWf.prim .nat`, the tree given to a hole nothing determines. -/
def natTyWfE : Expr :=
  mkApp (mkConst ``LeanScript.TyWf.prim) (mkConst ``LeanScript.LeanPrimTy.nat)

/-- The type of the language a translated term has: `τ` for `Term Sg Γ τ`. -/
def termTyOf (t : Expr) : MetaM Expr := do
  let ty ← whnfCore (← instantiateMVars (← inferType t))
  match ty.getAppFnArgs with
  | (`LeanScript.Term, #[_, _, τ, _]) => instantiateMVars τ
  | _ => throwError "`#leanscript_to_term`: internal: not a term of the language: {t}"

/-- The type of `e` as a tree, or — when the Lean type of `e` has no tree, as a value of a
    datatype with existentials has not — the type of its translation `t`. -/
def tyOfTermOr (e t : Expr) : MetaM Expr := do
  try tyOfTerm e catch _ => termTyOf t

/-- For each layout generated by `#leanscript_ctor` and used here, how many of its leading
    arguments are type variables; the others are the trees of its holes, which `joinTy`
    may join. -/
initialize layoutTyVarsRef : IO.Ref (Array (Name × Nat)) ← IO.mkRef #[]

/-! ## `TyWf.oneOf` -/

/-- The alternatives of `TyWf.oneOf a b cs`. -/
def oneOfAlts? (τ : Expr) : MetaM (Option (Array Expr)) := do
  let τ ← instantiateMVars τ
  let (``LeanScript.TyWf.oneOf, #[a, b, cs]) := τ.getAppFnArgs | return none
  let mut out := #[a, b]
  let mut cur := cs
  repeat
    match (← whnfR cur).getAppFnArgs with
    | (``List.cons, #[_, x, xs]) => out := out.push x; cur := xs
    | (``List.nil, _) => break
    | _ => return none
  return some out

/-- `TyWf.oneOf` of at least two alternatives. -/
def mkOneOf (alts : Array Expr) : MetaM Expr := do
  let some a := alts[0]? | throwError "`#leanscript_to_term`: internal: no alternative"
  let some b := alts[1]? | return a
  return mkApp3 (mkConst ``LeanScript.TyWf.oneOf) a b
    (← mkListLit tyWfTyE (alts.extract 2 alts.size).toList)

/-- The value `t`, of the type `alt`, as the alternative `i` of `TyWf.oneOf` `τ`. -/
def injectOneOf (sg γ τ : Expr) (i : Nat) (alt t : Expr) : MetaM Expr := do
  let some u ← unfoldDefinition? τ
    | throwError "`#leanscript_to_term`: internal: cannot unfold {τ}"
  let (``LeanScript.TyWf.taggedUnion, #[l]) := u.getAppFnArgs
    | throwError "`#leanscript_to_term`: internal: {τ} is not a tagged union"
  let lenE := mkApp2 (mkConst ``LeanScript.LeanTaggedUnionSchema.length) tyWfTyE l
  let prf ← mkDecideProof (← mkAppM ``LT.lt #[mkNatLit i, lenE])
  let nilTys := mkApp (mkConst ``List.nil [Level.zero]) tyWfTyE
  let spine := mkAppN (mkConst `LeanScript.Spine.cons)
    #[sg, γ, alt, nilTys, t, mkApp2 (mkConst `LeanScript.Spine.nil) sg γ]
  return mkAppN (mkConst `LeanScript.Term.taggedUnion_mk) #[sg, γ, l, mkNatLit i, prf, spine]

/-- The term `t` at the type `τ`: `t` itself when it has that type, and its injection when
    `τ` is a `TyWf.oneOf` one of whose alternatives is the type of `t`. -/
def coerceTo (c : TCtx) (t τ : Expr) : MetaM Expr := do
  let τt ← termTyOf t
  if ← isDefEq τt τ then return t
  if let some alts ← oneOfAlts? τ then
    for i in [0:alts.size] do
      if ← isDefEq τt alts[i]! then
        return ← injectOneOf c.sg c.gamma τ i alts[i]! t
  throwError "`#leanscript_to_term`: this value has the type{indentExpr τt}\nbut the type \
    {indentExpr τ}\nis expected here"

/-! ## Joining the types of two branches -/

mutual

/-- A type both `a` and `b` can be checked against: `a` when they are the same type; the
    same layout with the trees of its holes joined, when they are one layout at the same type
    variables (or two functions with the same domain); `TyWf.oneOf` of their alternatives
    otherwise. -/
partial def joinTy (a b : Expr) : MetaM Expr := do
  let a ← instantiateMVars a
  let b ← instantiateMVars b
  if ← isDefEq a b then return a
  if let some r ← joinSameHead? a b then return r
  let mut alts := (← oneOfAlts? a).getD #[a]
  for x in (← oneOfAlts? b).getD #[b] do
    unless ← alts.anyM (isDefEq · x) do alts := alts.push x
  mkOneOf alts

/-- `joinTy` of two applications of the same layout (or of `TyWf.fn`), hole by hole. -/
partial def joinSameHead? (a b : Expr) : MetaM (Option Expr) := do
  let .const na _ := a.getAppFn | return none
  let .const nb _ := b.getAppFn | return none
  unless na == nb do return none
  let as := a.getAppArgs
  let bs := b.getAppArgs
  unless as.size == bs.size do return none
  let reg ← layoutTyVarsRef.get
  let k? : Option Nat :=
    if na == ``LeanScript.TyWf.fn then some 1
    else (reg.find? (·.1 == na)).map (·.2)
  let some k := k? | return none
  for i in [0:min k as.size] do
    unless ← isDefEq as[i]! bs[i]! do return none
  let mut out := as
  for i in [k:as.size] do
    if ← isDefEq as[i]! bs[i]! then continue
    unless (← whnf (← inferType as[i]!)).isConstOf ``LeanScript.TyWf do return none
    out := out.set! i (← joinTy as[i]! bs[i]!)
  return some (mkAppN a.getAppFn out)

end

/-! ## A constructor application, through its constructor function -/

/-- Does the datatype `n`, or a member of its `mutual` block, have existentials? -/
def hasExistentials (n : Name) : MetaM Bool := do
  let ind ← getConstInfoInduct n
  ind.all.anyM fun m => do
    let mi ← getConstInfoInduct m
    forallBoundedTelescope mi.type mi.numParams fun ps body =>
      forallTelescopeReducing body fun idxs _ => do
        let typeIdx ← idxs.mapM fun x => do LeanScript.Deriving.isTypeField (← inferType x)
        return !(← LeanScript.CtorFn.classify mi ps typeIdx).whole

/-- Is this constructor application translated through the constructor function — is it a
    value of a datatype with existentials (or of one in the same `mutual` block), whose Lean
    type has no tree of the language? -/
def usesCtorFn (e : Expr) (ci : ConstructorVal) : MetaM Bool := do
  unless ← hasExistentials ci.induct do return false
  try discard (tyOfTerm e); return false catch _ => return true

/-- Drop the binder of `fun x => b` whose type the language erases: `b` itself, with a `Unit`
    binder read as `()`. -/
def dropErasedBinder (e : Expr) : MetaM Expr := do
  let .lam n d b _ := e | throwError "`#leanscript_to_term`: internal: not a function"
  unless b.hasLooseBVars do return b
  match (← whnf d) with
  | .const ``PUnit [u] => return b.instantiate1 (mkConst ``PUnit.unit [u])
  | _ => throwError "`#leanscript_to_term`: `{n}` has the type {d}, which the language \
      erases, and is used"

/-- Translate `fun x => b` whose binder the language erases: `b` itself, by `k`.  A `Unit`
    binder is read as `()` (`dropErasedBinder`); a **type** binder, or a proof, that the
    body still mentions — the index `α` of an indexed family, `fun {α} (e : TExpr α) => …`,
    or the index a `match` refines — is bound as a Lean variable that the language never
    sees: it may occur in the *types* of the body (`TExpr α`), whose trees do not depend on
    it, but the term the body translates to must not mention it. -/
def withErasedBinder (e : Expr) (k : Expr → MetaM Expr) : MetaM Expr := do
  let .lam n d b bi := e | throwError "`#leanscript_to_term`: internal: not a function"
  unless b.hasLooseBVars do return ← k b
  if let .const ``PUnit [u] := (← whnf d) then
    return ← k (b.instantiate1 (mkConst ``PUnit.unit [u]))
  withLocalDecl n bi d fun x => do
    let t ← instantiateMVars (← k (b.instantiate1 x))
    if t.containsFVar x.fvarId! then
      throwError "`#leanscript_to_term`: `{n}` has the type {d}, which the language \
        erases, and is used"
    return t

/-- The type of the language that models the Lean type `α`, written `TyWf.prim p` when it
    is a terminal type. -/
def tyWfOfType (α : Expr) : MetaM Expr := do
  if let (``LeanScript.Ty.shape, #[s]) := (← treeOfType α).getAppFnArgs then
    if let (``LeanScript.TyShape.prim, #[_, p]) := s.getAppFnArgs then
      return mkApp (mkConst ``LeanScript.TyWf.prim) p
  tyOfType α

/-- The constructor application `ci args`, built by the constructor function of `ci`
    (`#leanscript_ctor`), generated or found in its cache.  `synth` translates a field,
    `check` translates it against a type; `expected?` is the type the value is checked
    against, if there is one, and fixes the trees of the holes. -/
def ctorFnApp (synth : TCtx → Expr → MetaM Expr) (check : TCtx → Expr → Expr → MetaM Expr)
    (c : TCtx) (ci : ConstructorVal) (args : Array Expr) (expected? : Option Expr) :
    MetaM Expr := do
  let vals ← LeanScript.CtorFn.tyVarValues ci args
  let erased ← vals.mapM LeanScript.Deriving.erasedBinder
  let (layName, fnName) ← LeanScript.CtorFn.ensureCtorFn ci.name erased
  let kept := (vals.zip erased).filterMap fun (v, er) => if er then none else some v
  layoutTyVarsRef.modify fun r =>
    if r.any (·.1 == layName) then r else r.push (layName, kept.size)
  let fnC ← mkConstWithFreshMVarLevels fnName
  let mut cur := mkApp2 fnC c.sg c.gamma
  let mut ty ← instantiateForall (← inferType fnC) #[c.sg, c.gamma]
  -- the type variables
  for v in kept do
    let .forallE _ _ b _ := ty
      | throwError "`#leanscript_to_term`: internal: `{fnName}` takes fewer type arguments"
    let t ← tyWfOfType v
    cur := mkApp cur t
    ty := b.instantiate1 t
  -- the holes
  let mut holes : Array Expr := #[]
  repeat
    let .forallE _ d b _ := ty | break
    unless d.isConstOf ``LeanScript.TyWf do break
    let m ← mkFreshExprMVar tyWfTyE
    holes := holes.push m
    cur := mkApp cur m
    ty := b.instantiate1 m
  -- the fields: each binder of the function is named after a field of the constructor
  let names ← forallTelescope ci.type fun xs _ => xs.mapM (·.fvarId!.getUserName)
  let mut fields : Array (Expr × Expr) := #[]
  repeat
    let .forallE n d b _ := ty | break
    let (`LeanScript.Term, #[_, _, τ, _]) := d.getAppFnArgs
      | throwError "`#leanscript_to_term`: internal: `{fnName}` has an unexpected argument {n}"
    let some i := (names.extract ci.numParams names.size).findIdx? (· == n)
      | throwError "`#leanscript_to_term`: internal: `{ci.name}` has no field `{n}`"
    let some a := args[ci.numParams + i]?
      | throwError "`#leanscript_to_term`: internal: `{ci.name}` lacks its field `{n}`"
    fields := fields.push (a, τ)
    if b.hasLooseBVars then
      throwError "`#leanscript_to_term`: internal: `{fnName}` has a dependent type"
    ty := b
  let (`LeanScript.Term, #[_, _, resTy, _]) := ty.getAppFnArgs
    | throwError "`#leanscript_to_term`: internal: `{fnName}` does not build a term"
  if let some τ := expected? then
    if (← oneOfAlts? τ).isNone then discard <| isDefEq resTy τ
  for (a, τ) in fields do
    let τ ← instantiateMVars τ
    let t ← if τ.hasExprMVar then do
        let t ← synth c a
        let τt ← termTyOf t
        unless ← isDefEq τt τ do
          throwError "`#leanscript_to_term`: the field {a} of `{ci.name}` translates to a \
            value of type{indentExpr τt}\nwhich is not of the form{indentExpr τ}"
        pure t
      else check c a τ
    cur := mkApp cur t
  -- a hole nothing determined (a field that is never built) is given `nat`
  for m in holes do
    if (← instantiateMVars m).isMVar then m.mvarId!.assign natTyWfE
  instantiateMVars cur

end LeanScript.ToTerm

end

end
